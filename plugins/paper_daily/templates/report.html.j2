<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ArXiv 日报 - {{ report_date }}</title>
<style>
  body { font-family: -apple-system, "Noto Sans SC", sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; color: #333; }
  h1 { border-bottom: 2px solid #2563eb; padding-bottom: 8px; }
  .paper { border-bottom: 1px solid #eee; padding: 16px 0; }
  .paper-title a { color: #2563eb; text-decoration: none; font-size: 1.1em; }
  .paper-title a:hover { text-decoration: underline; }
  .meta { color: #666; font-size: 0.9em; margin: 4px 0; }
  .stars { color: #f59e0b; }
  .tags { margin: 4px 0; }
  .tag { display: inline-block; background: #eff6ff; color: #2563eb; border-radius: 4px; padding: 2px 8px; font-size: 0.85em; margin-right: 4px; }
  .summary { margin-top: 8px; line-height: 1.7; }
</style>
</head>
<body>
<h1>ArXiv 日报 - {{ report_date }}</h1>
<p>共筛选出 <strong>{{ papers|length }}</strong> 篇相关论文。</p>
{% for paper in papers %}
<div class="paper">
  <div class="paper-title"><a href="{{ paper.entry_url }}">{{ paper.title }}</a></div>
  <div class="meta">相关度: <span class="stars">{{ '★' * paper.relevance_score }}{{ '☆' * (5 - paper.relevance_score) }}</span> | {{ paper.relevance_reason }}</div>
  {% if paper.matched_topics %}<div class="tags">关联主题: {% for t in paper.matched_topics %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
  <div class="summary">{{ paper.summary_zh }}</div>
</div>
{% endfor %}
</body>
</html>
